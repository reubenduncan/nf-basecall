params {

    // -----------------------------------------------------------------------
    // Input / output
    // -----------------------------------------------------------------------
    input              = null
    outdir             = 'results'

    // -----------------------------------------------------------------------
    // Basecalling model
    // Shorthand: 'fast' | 'hac' | 'sup'
    // Full name:  e.g. 'dna_r10.4.1_e8.2_400bps_hac@v5.0.0'
    // With mods:  specify mods separately via --modified_bases
    // -----------------------------------------------------------------------
    model              = 'hac'

    // Comma-separated modification models to detect alongside basecalling.
    // Examples: '5mCG_5hmCG'  '5mCG_5hmCG,6mA'  '5mC_5hmC'
    modified_bases     = null

    // Local directory where Dorado searches for / caches models.
    // Set via env var DORADO_MODELS_DIRECTORY or this param.
    models_directory   = null

    // -----------------------------------------------------------------------
    // Output format  (mutually exclusive; default = BAM)
    // -----------------------------------------------------------------------
    emit_fastq         = false   // FASTQ
    emit_sam           = false   // SAM
    emit_cram          = false   // CRAM

    // Include the signal move table (mv tag) — required by tools such as Remora
    emit_moves         = false

    // Write sequencing_summary.txt inline during basecalling
    emit_summary       = false

    // -----------------------------------------------------------------------
    // Quality filtering
    // -----------------------------------------------------------------------
    min_qscore         = 0       // 0 = no filter; typical value: 8–10

    // -----------------------------------------------------------------------
    // Alignment  (inline, via minimap2 bundled in Dorado)
    // -----------------------------------------------------------------------
    reference          = null    // path to FASTA / FASTQ / .mmi reference index
    bed_file           = null    // BED file — overlap counts written to 'bh' BAM tag
    mm2_opts           = null    // custom minimap2 options, e.g. '-k 15 -w 10'
                                 // (overrides the default lr:hq preset)

    // -----------------------------------------------------------------------
    // Adapter / primer trimming
    // -----------------------------------------------------------------------
    // 'adapters' — trim sequencing adapters only (default)
    // 'all'      — trim adapters, primers, and barcodes
    // 'none'     — disable trimming
    trim               = 'adapters'

    // Equivalent to --no-trim; overrides the trim setting above
    no_trim            = false

    // -----------------------------------------------------------------------
    // Barcode demultiplexing
    // When kit_name is set the basecaller classifies reads (BC tag).
    // DORADO_DEMUX then splits the classified BAM into per-barcode files.
    // -----------------------------------------------------------------------
    kit_name           = null    // e.g. 'SQK-RBK114-96', 'SQK-NBD114-24'
    barcode_both_ends  = false   // require barcode on both read ends
    barcode_arrangement = null   // path to custom barcode arrangement file
    barcode_sequences  = null    // path to custom barcode sequences file

    // -----------------------------------------------------------------------
    // Poly-A tail estimation
    // -----------------------------------------------------------------------
    estimate_poly_a    = false

    // -----------------------------------------------------------------------
    // Read selection
    // -----------------------------------------------------------------------
    recursive          = false   // recursively scan input dir for POD5 files
    read_ids           = null    // path to newline-delimited list of read IDs
    max_reads          = null    // hard cap on the number of reads processed

    // -----------------------------------------------------------------------
    // Performance tuning
    // -----------------------------------------------------------------------
    // GPU device selection:
    //   null       → Dorado auto-detects (tries GPU, falls back to CPU)
    //   'cuda:all' → use all available NVIDIA GPUs (set automatically by gpu profile)
    //   'cuda:0'   → first GPU only
    //   'cpu'      → force CPU (slow)
    //   'metal'    → Apple Silicon GPU
    device             = null

    // Batch size (number of chunks per batch).  0 = auto-tune from free GPU memory.
    batchsize          = 0

    // Chunk size in samples (default 10000) and overlap between chunks (default 500).
    // Increase overlap for higher accuracy on long homopolymers; decrease chunksize
    // to reduce GPU memory pressure.
    chunksize          = null
    overlap            = null

    // Number of parallel neural-network runners per device.  null = Dorado auto-selects.
    // Increasing this can improve GPU utilisation on multi-core systems.
    num_runners        = null

    // -----------------------------------------------------------------------
    // Resume an interrupted basecalling job
    // -----------------------------------------------------------------------
    resume_from        = null    // path to an existing partial BAM

    // -----------------------------------------------------------------------
    // Duplex basecalling
    // Calls both strands together for higher per-read accuracy.
    // NOTE: not compatible with --correct.
    // -----------------------------------------------------------------------
    duplex             = false
    pairs_file         = null    // path to CSV of template/complement read ID pairs
                                 // (omit to let Dorado auto-detect pairs)

    // -----------------------------------------------------------------------
    // Read error correction  (dorado correct, HERRO algorithm)
    // Recommended system: >= 64 CPU cores, >= 256 GB RAM, >= 32 GB GPU VRAM.
    // Input reads should be >= 10 kbp with >= 30x coverage.
    // NOTE: not compatible with --duplex.
    // -----------------------------------------------------------------------
    correct            = false
    paf_file           = null    // pre-computed PAF file (skips internal alignment step)
}

// ---------------------------------------------------------------------------
// Per-process resource defaults
// ---------------------------------------------------------------------------
process {
    cpus   = 4
    memory = '16 GB'
    time   = '24h'

    withName: 'DORADO_BASECALL' {
        cpus   = 4
        memory = '32 GB'
        time   = '24h'
    }

    withName: 'DORADO_DUPLEX' {
        cpus   = 8
        memory = '64 GB'
        time   = '48h'
    }

    withName: 'DORADO_DEMUX' {
        cpus   = 8
        memory = '16 GB'
        time   = '4h'
    }

    withName: 'DORADO_SUMMARY' {
        cpus   = 2
        memory = '8 GB'
        time   = '2h'
    }

    // HERRO error correction is very resource-hungry; tune for your cluster.
    withName: 'DORADO_CORRECT' {
        cpus   = 64
        memory = '256 GB'
        time   = '72h'
    }
}

// ---------------------------------------------------------------------------
// Execution profiles
// ---------------------------------------------------------------------------
profiles {

    // GPU profile — enables NVIDIA GPU acceleration across all GPU-using processes.
    // Pairs well with docker or singularity: nextflow run ... -profile gpu,docker
    gpu {
        params.device = 'cuda:all'   // use every available GPU on the node
        process {
            withName: 'DORADO_BASECALL|DORADO_DUPLEX|DORADO_CORRECT' {
                accelerator      = 1
                containerOptions = '--gpus all'
            }
        }
    }

    docker {
        docker.enabled = true
        process {
            container = 'ontresearch/dorado:latest'
        }
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        process {
            container = 'docker://ontresearch/dorado:latest'
        }
    }

    // SLURM profile for HPC clusters.
    // Combine with gpu and docker/singularity:
    //   nextflow run ... -profile slurm,gpu,singularity
    slurm {
        process {
            executor       = 'slurm'
            queue          = 'gpu'
            clusterOptions = '--gres=gpu:1'

            withName: 'DORADO_BASECALL' {
                cpus   = 8
                memory = '64 GB'
                time   = '48h'
            }
            withName: 'DORADO_DUPLEX' {
                cpus   = 16
                memory = '128 GB'
                time   = '72h'
            }
            withName: 'DORADO_DEMUX' {
                cpus           = 8
                memory         = '16 GB'
                time           = '4h'
                clusterOptions = ''   // demux runs on CPU; no GPU needed
            }
            withName: 'DORADO_SUMMARY' {
                cpus           = 2
                memory         = '8 GB'
                time           = '2h'
                clusterOptions = ''   // CPU-only
            }
            withName: 'DORADO_CORRECT' {
                cpus           = 64
                memory         = '256 GB'
                time           = '72h'
                clusterOptions = '--gres=gpu:1'
            }
        }
    }
}

// ---------------------------------------------------------------------------
// Pipeline execution reports
// ---------------------------------------------------------------------------
report   { enabled = true; file = "${params.outdir}/pipeline_info/execution_report.html"   }
timeline { enabled = true; file = "${params.outdir}/pipeline_info/execution_timeline.html" }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/execution_trace.txt"     }
